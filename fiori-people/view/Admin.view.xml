<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:breadcrumbs><Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs></f:breadcrumbs>
			<f:heading><Title text="{vm>/admin/title}" wrapping="true"/></f:heading>
			<f:expandedContent><Label text="{vm>/admin/sub}" wrapping="true"/></f:expandedContent>
			<f:snappedContent><Label text="{vm>/admin/sub}"/></f:snappedContent>
			<f:actions></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<VBox height="26rem" visible="{= !!${vm>/admin/denied} }"><MessagePage showHeader="false" text="{vm>/admin/title}" description="{vm>/admin/msg}" icon="sap-icon://locked"><buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons></MessagePage></VBox>
				<VBox visible="{= !${vm>/admin/denied} }" renderType="Bare" class="tsGap">

					<f:Card>
						<f:header><card:Header title="Applications" subtitle="External addresses must start with https://. With no address, the application shows as not configured." iconSrc="sap-icon://grid"/></f:header>
						<f:content>
							<Table items="{vm>/admin/apps}" contextualWidth="Auto" fixedLayout="false">
								<columns>
									<Column><Text text="Application"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Type"/></Column>
									<Column><Text text="Availability"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Who can use it"/></Column><Column><Text text="Address"/></Column>
								</columns>
								<ColumnListItem vAlign="Middle">
									<HBox alignItems="Center" class="tsGapS" renderType="Bare"><core:Icon src="{vm>icon}"/><Text text="{vm>label}"/></HBox>
									<Text text="{vm>kind}"/>
									<ObjectStatus text="{vm>avail}" state="{vm>availState}"/>
									<Text text="{vm>who}"/>
									<HBox class="tsGapS" alignItems="Center" renderType="Bare">
										<Text visible="{= !${vm>external} }" text="{vm>route}"/>
										<Input visible="{vm>external}" value="{vm>url}" placeholder="https://…" width="14rem"/>
										<Button visible="{vm>external}" text="Save" press=".onSetUrl"/>
									</HBox>
								</ColumnListItem>
							</Table>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="Appraisal workflow" iconSrc="sap-icon://process"/></f:header>
						<f:content>
							<VBox class="tsPad" width="100%" renderType="Bare">
								<CheckBox text="Include a Calibration step after the manager review" selected="{vm>/admin/cal}" select=".onCfg"><customData><core:CustomData key="k" value="calibration"/></customData></CheckBox>
								<CheckBox text="Let employees appeal to HR at acknowledgement" selected="{vm>/admin/appeal}" select=".onCfg"><customData><core:CustomData key="k" value="appeal"/></customData></CheckBox>
								<Text text="{vm>/admin/flow}" class="tsMeta"/>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="Training needs" iconSrc="sap-icon://education"/></f:header>
						<f:content>
							<VBox class="tsPad" width="100%" renderType="Bare">
								<CheckBox text="Allow “No training needs identified”, with a required reason" selected="{vm>/admin/noTna}" select=".onCfg"><customData><core:CustomData key="k" value="noTnaAllowed"/></customData></CheckBox>
								<Text text="{vm>/admin/tnaMax}" class="tsMeta"/>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="Rating" iconSrc="sap-icon://measure"/></f:header>
						<f:content>
							<VBox class="tsPad" width="100%" renderType="Bare">
								<Table items="{vm>/admin/scale}"><columns><Column width="5rem"><Text text="Value"/></Column><Column><Text text="Label"/></Column></columns><ColumnListItem><ObjectNumber number="{vm>v}"/><Text text="{vm>label}"/></ColumnListItem></Table>
								<Label text="Decimal places for the overall rating" labelFor="cfgdec" class="sapUiSmallMarginTop"/>
								<Select id="cfgdec" width="8rem" selectedKey="{vm>/admin/decimals}" items="{vm>/admin/decOpts}" change=".onCfg"><customData><core:CustomData key="k" value="decimals"/></customData><core:Item key="{vm>key}" text="{vm>text}"/></Select>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="Performance form" iconSrc="sap-icon://survey"/></f:header>
						<f:content>
							<VBox class="tsPad" width="100%" renderType="Bare">
								<CheckBox text="Number the form sections (01, 02 …)" selected="{vm>/admin/numbers}" select=".onCfg"><customData><core:CustomData key="k" value="numbers"/></customData></CheckBox>
								<Label text="Default form theme" labelFor="cfgth" class="sapUiSmallMarginTop"/>
								<Select id="cfgth" width="14rem" selectedKey="{vm>/admin/theme}" items="{vm>/admin/themes}" change=".onCfg"><customData><core:CustomData key="k" value="theme"/></customData><core:Item key="{vm>key}" text="{vm>text}"/></Select>
							</VBox>
						</f:content>
					</f:Card>
				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>