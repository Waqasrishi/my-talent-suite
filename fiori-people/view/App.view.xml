<mvc:View controllerName="ajmn.people.controller.Main" displayBlock="true" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:tnt="sap.tnt">
	<tnt:ToolPage id="toolPage">
		<tnt:header>
			<tnt:ToolHeader>
				<Button icon="sap-icon://menu2" type="Transparent" tooltip="Menu" press=".onToggleSide">
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
				</Button>
				<Avatar src="sap-icon://group" displaySize="XS" backgroundColor="Accent6" tooltip="AJMN People"/>
				<Title text="AJMN People" level="H1">
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
				</Title>
				<Text text="Al Jazeera Media Network · in-house platform" wrapping="false" class="tsMeta"/>
				<ToolbarSpacer/>
				<SearchField id="gsearch" width="22rem" placeholder="Search goals, people, appraisals or apps" enableSuggestions="true"
					suggest=".onSuggest" search=".onSearch" suggestionItems="{form>/search}">
					<suggestionItems><SuggestionItem text="{form>t}" description="{form>k}" key="{form>h}"/></suggestionItems>
				</SearchField>
				<Button icon="sap-icon://bell" type="Transparent" tooltip="Notifications" press=".onBell">
					<customData><BadgeCustomData key="badge" value="{vm>/sh/bell/text}" visible="{= ${vm>/sh/bell/count} > 0 }"/></customData>
				</Button>
				<Button icon="sap-icon://grid" type="Transparent" tooltip="Applications" press=".onApps"/>
				<Button icon="sap-icon://dark-mode" type="Transparent" tooltip="Light or dark theme" press=".onTheme"/>
				<Avatar initials="{vm>/sh/me/initials}" displaySize="XS" backgroundColor="Accent6" tooltip="{vm>/sh/me/name}" press=".onMe"/>
			</tnt:ToolHeader>
		</tnt:header>
		<tnt:sideContent>
			<tnt:SideNavigation selectedKey="{vm>/sh/navKey}" itemSelect=".onNav">
				<tnt:NavigationList items="{vm>/sh/nav}">
					<tnt:NavigationListItem key="{vm>key}" text="{vm>text}" icon="{vm>icon}"/>
				</tnt:NavigationList>
				<tnt:fixedItem>
					<tnt:NavigationList>
						<tnt:NavigationListItem text="Demonstration · sample data · not connected to SAP" icon="sap-icon://hint" selectable="false" enabled="false"/>
					</tnt:NavigationList>
				</tnt:fixedItem>
			</tnt:SideNavigation>
		</tnt:sideContent>
		<tnt:mainContents>
			<VBox height="100%" renderType="Bare">
				<MessageStrip visible="{= !!${vm>/sh/saveErr} }" type="Error" showIcon="true"
					text="Changes could not be saved in this browser. They will be lost when you reload. Check that site data is allowed, then try again."/>
				<NavContainer id="pages" height="100%">
					<layoutData><FlexItemData growFactor="1" baseSize="0" minHeight="0"/></layoutData>
				</NavContainer>
			</VBox>
		</tnt:mainContents>
	</tnt:ToolPage>
</mvc:View>
