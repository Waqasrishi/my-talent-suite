<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:uxap="sap.uxap" xmlns:unified="sap.ui.unified" xmlns:mc="sap.suite.ui.microchart">
	<VBox height="100%" renderType="Bare">
		<VBox height="26rem" visible="{= !!${vm>/appraisal/denied} }">
			<MessagePage showHeader="false" text="{vm>/appraisal/title}" description="{vm>/appraisal/msg}" icon="sap-icon://locked">
				<buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons>
			</MessagePage>
		</VBox>
		<uxap:ObjectPageLayout id="apPage" visible="{= !${vm>/appraisal/denied} }" upperCaseAnchorBar="false" showTitleInHeaderContent="false" class="tsAp" height="100%"
			headerContentPinnable="true" isChildPage="false" useIconTabBar="false">
			<uxap:customData><core:CustomData key="theme" value="{= ${vm>/appraisal/theme} || 'light' }" writeToDom="true"/></uxap:customData>
			<uxap:headerTitle>
				<uxap:ObjectPageDynamicHeaderTitle>
					<uxap:breadcrumbs>
						<Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs>
					</uxap:breadcrumbs>
					<uxap:heading><Title text="{vm>/appraisal/title}" wrapping="true"/></uxap:heading>
					<uxap:expandedContent><Label text="{vm>/appraisal/who}"/></uxap:expandedContent>
					<uxap:snappedContent><Label text="{vm>/appraisal/who}"/></uxap:snappedContent>
					<uxap:actions>
						<Button text="Return for revision" visible="{= !!${vm>/appraisal/canReturn} }" press=".onApReturnOpen"/>
						<Button text="Open goal plan" press=".onHref"><customData><core:CustomData key="href" value="{vm>/appraisal/goalPlan}"/></customData></Button>
						<Button icon="sap-icon://print" tooltip="Print / Save as PDF" press=".onPrint"/>
						<Button text="Save draft" visible="{= !!${vm>/appraisal/canSave} }" press=".onApSave"/>
						<Button text="{vm>/appraisal/submitLabel}" type="Emphasized" visible="{= !!${vm>/appraisal/canSave} }" press=".onApSubmit"/>
					</uxap:actions>
				</uxap:ObjectPageDynamicHeaderTitle>
			</uxap:headerTitle>
			<uxap:headerContent>
				<VBox class="tsGapS" renderType="Bare">
					<HBox class="tsWrap" alignItems="Center" renderType="Bare">
						<ObjectStatus text="{vm>/appraisal/status}" state="{vm>/appraisal/statusState}" inverted="true"/>
						<Text text="{vm>/appraisal/stepLine}"/>
						<Text text="{= ${form>/ap/dirty} ? 'Unsaved changes' : ${vm>/appraisal/saved} }" class="tsMeta"/>
					</HBox>
					<HBox class="tsSteps" renderType="Bare" items="{vm>/appraisal/steps}">
						<ObjectStatus text="{vm>text} · {vm>sub}" state="{vm>state}" icon="{vm>icon}" inverted="true" active="true" press=".onStepInfo"/>
					</HBox>
					<HBox class="tsWrap" alignItems="Center" renderType="Bare">
						<Label text="Form theme"/>
						<SegmentedButton selectedKey="{vm>/appraisal/theme}" selectionChange=".onApTheme">
							<items><SegmentedButtonItem key="light" text="Broadcast Light"/><SegmentedButtonItem key="gold" text="Executive Gold"/></items>
						</SegmentedButton>
					</HBox>
					<MessageStrip visible="{= !!${vm>/appraisal/back} }" type="Warning" showIcon="true" text="{vm>/appraisal/back}"/>
					<MessageStrip visible="{= !!${vm>/appraisal/saveFail} }" type="Error" showIcon="true" text="Saving failed. Your changes are still on this page and the last saved version is unchanged. Try again."/>
					<VBox visible="{= ${vm>/appraisal/errs}.length > 0 }" renderType="Bare">
						<MessageStrip type="Error" showIcon="true" text="{= ${vm>/appraisal/errs}.length } to fix before submitting:" class="sapUiTinyMarginBottom"/>
						<VBox items="{vm>/appraisal/errs}"><Link text="{vm>text}" wrapping="true" press=".onSecJump"/></VBox>
					</VBox>
				</VBox>
			</uxap:headerContent>
			<uxap:sections>

				<uxap:ObjectPageSection id="sec-overview" title="{vm>/appraisal/sec/overview}">
					<uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
						<VBox class="tsSecBlock" renderType="Bare">
							<VBox items="{vm>/appraisal/overview}"><HBox class="tsKv" renderType="Bare"><Label text="{vm>k}"/><Text text="{vm>v}"/></HBox></VBox>
							<Text text="{vm>/appraisal/overviewNote}" class="tsMeta"/>
						</VBox>
					</uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
				</uxap:ObjectPageSection>

				<uxap:ObjectPageSection id="sec-profile" title="{vm>/appraisal/sec/profile}">
					<uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
						<VBox class="tsSecBlock" renderType="Bare">
							<VBox items="{vm>/appraisal/profile}"><HBox class="tsKv" renderType="Bare"><Label text="{vm>k}"/><Text text="{vm>v}"/></HBox></VBox>
						</VBox>
					</uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
				</uxap:ObjectPageSection>

				<uxap:ObjectPageSection id="sec-objectives" title="{vm>/appraisal/sec/objectives}">
					<uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
						<VBox class="tsSecBlock" renderType="Bare">
							<HBox class="tsWrap" renderType="Bare"><ObjectStatus text="Contributes 100% to the overall rating" state="Information" inverted="true"/></HBox>
							<Text text="Achievement is each goal’s measured progress, for reference. It does not set a rating; ratings are chosen by the employee and the manager." class="tsMeta"/>
							<Table items="{form>/ap/rows}" contextualWidth="Auto" fixedLayout="false" noDataText="No approved goals with a weight in this cycle.">
								<columns>
									<Column width="3rem"><Text text="#"/></Column>
									<Column width="16rem"><Text text="Objective and alignment"/></Column>
									<Column width="5rem" hAlign="End"><Text text="Weight"/></Column>
									<Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Achievement"/></Column>
									<Column width="16rem"><Text text="Employee rating and comment"/></Column>
									<Column width="16rem"><Text text="Manager rating and comment"/></Column>
									<Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Evidence"/></Column>
								</columns>
								<ColumnListItem vAlign="Top">
									<Text text="{form>n}"/>
									<VBox renderType="Bare">
										<Link text="{form>title}" wrapping="true" href="{form>href}"/>
										<Text text="{form>align}" class="tsMeta"/>
										<ObjectStatus visible="{= !!${form>chg} }" state="Warning" text="The goal changed after this form was submitted; the form keeps the submitted version."/>
									</VBox>
									<Text text="{form>weightText}"/>
									<ProgressIndicator percentValue="{form>pct}" displayValue="{form>pctText}" displayOnly="true" state="Information"/>
									<VBox class="tsGapS" renderType="Bare">
										<Select width="100%" visible="{= ${vm>/appraisal/empCell} !== 'hidden' }" editable="{= !!${vm>/appraisal/canSelf} }" selectedKey="{form>er}" items="{path: 'vm>/appraisal/scale', templateShareable: false}" change=".onApRate">
											<core:Item key="{vm>key}" text="{vm>text}"/>
										</Select>
										<TextArea width="100%" rows="2" visible="{= ${vm>/appraisal/empCell} === 'edit' || (${vm>/appraisal/empCell} === 'read' &amp;&amp; !!${form>ec}) }" editable="{= !!${vm>/appraisal/canSelf} }" value="{form>ec}" placeholder="Your comment" liveChange=".onApDirty"/>
										<Text visible="{= ${vm>/appraisal/empCell} === 'hidden' }" text="{vm>/appraisal/hiddenEmp}" class="tsMeta"/>
									</VBox>
									<VBox class="tsGapS" renderType="Bare">
										<Select width="100%" visible="{= ${vm>/appraisal/mgrCell} !== 'hidden' }" editable="{= !!${vm>/appraisal/canMgr} }" selectedKey="{form>mr}" items="{path: 'vm>/appraisal/scale', templateShareable: false}" change=".onApRate">
											<core:Item key="{vm>key}" text="{vm>text}"/>
										</Select>
										<TextArea width="100%" rows="2" visible="{= ${vm>/appraisal/mgrCell} === 'edit' || (${vm>/appraisal/mgrCell} === 'read' &amp;&amp; !!${form>mc}) }" editable="{= !!${vm>/appraisal/canMgr} }" value="{form>mc}" placeholder="Manager comment" liveChange=".onApDirty"/>
										<Text visible="{= ${vm>/appraisal/mgrCell} === 'hidden' }" text="{vm>/appraisal/hiddenMgr}" class="tsMeta"/>
									</VBox>
									<Input value="{form>ev}" editable="{= !!${vm>/appraisal/canSelf} }" placeholder="Report, link or note" liveChange=".onApDirty"/>
								</ColumnListItem>
							</Table>
							<HBox class="tsWrap" alignItems="Center" renderType="Bare">
								<Label text="Total weight"/>
								<ObjectStatus text="{vm>/appraisal/wsumText}" state="{= ${vm>/appraisal/wsumWarn} ? 'Error' : 'Success' }"/>
								<Text visible="{= !!${vm>/appraisal/wsumWarn} }" text="{vm>/appraisal/wsumWarn}" class="tsMeta"/>
							</HBox>
						</VBox>
					</uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
				</uxap:ObjectPageSection>

				<uxap:ObjectPageSection id="sec-tna" title="{vm>/appraisal/sec/tna}">
					<uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
						<VBox class="tsSecBlock" renderType="Bare">
							<HBox class="tsWrap" renderType="Bare">
								<ObjectStatus text="Manager required" state="Warning" inverted="true"/>
								<ObjectStatus text="Development plan: Training Needs Assessment" state="None" inverted="true"/>
								<ObjectStatus text="Not scored" state="None" inverted="true"/>
							</HBox>
							<Text visible="{= !${vm>/appraisal/tnaVis} }" text="Your manager completes this section during the manager review. You will see it once it is submitted."/>
							<VBox visible="{= !!${vm>/appraisal/tnaVis} }" class="tsGapS" renderType="Bare">
								<Text text="{vm>/appraisal/tnaIntro}" class="tsMeta"/>
								<Table items="{form>/ap/tna}" contextualWidth="Auto" fixedLayout="false" noDataText="No training needs yet.">
									<columns>
										<Column width="3rem"><Text text="#"/></Column>
										<Column><Text text="Development area"/></Column>
										<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Capability gap"/></Column>
										<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Proposed learning"/></Column>
										<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Expected outcome"/></Column>
										<Column minScreenWidth="Desktop" demandPopin="true" width="10rem"><Text text="Target date"/></Column>
										<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Development record"/></Column>
										<Column width="3rem"><Text text=""/></Column>
									</columns>
									<ColumnListItem vAlign="Middle">
										<Text text="{form>n}"/>
										<Input value="{form>area}" editable="{= !!${vm>/appraisal/tnaEdit} }" placeholder="Development area" liveChange=".onApDirty"/>
										<Input value="{form>gap}" editable="{= !!${vm>/appraisal/tnaEdit} }" placeholder="Capability gap" liveChange=".onApDirty"/>
										<Select width="100%" selectedKey="{form>learningId}" editable="{= !!${vm>/appraisal/tnaEdit} }" items="{path: 'vm>/appraisal/learn', templateShareable: false}" change=".onApDirty"><core:Item key="{vm>key}" text="{vm>text}"/></Select>
										<Input value="{form>outcome}" editable="{= !!${vm>/appraisal/tnaEdit} }" placeholder="Expected outcome" liveChange=".onApDirty"/>
										<DatePicker value="{form>due}" valueFormat="yyyy-MM-dd" displayFormat="medium" editable="{= !!${vm>/appraisal/tnaEdit} }" change=".onApDirty"/>
										<Link text="{form>rec}" enabled="{= !!${form>recHref} }" href="{form>recHref}"/>
										<Button icon="sap-icon://decline" type="Transparent" tooltip="Remove training need" visible="{= !!${vm>/appraisal/tnaEdit} }" press=".onTnaDel"/>
									</ColumnListItem>
								</Table>
								<HBox class="tsWrap" alignItems="Center" renderType="Bare">
									<Button text="+ Add training need" visible="{= !!${vm>/appraisal/tnaEdit} &amp;&amp; !!${form>/ap/tnaCanAdd} }" press=".onTnaAdd"/>
									<Text visible="{= !!${vm>/appraisal/tnaEdit} &amp;&amp; !${form>/ap/tnaCanAdd} }" text="Maximum of {vm>/appraisal/tnaMax} training needs reached." class="tsMeta"/>
								</HBox>
								<VBox visible="{= !!${vm>/appraisal/noTnaShow} }" class="tsGapS" renderType="Bare">
									<CheckBox text="No training needs identified" selected="{form>/ap/noTnaOn}" editable="{= !!${vm>/appraisal/tnaEdit} }" select=".onApDirty"/>
									<Input visible="{= !!${form>/ap/noTnaOn} }" value="{form>/ap/noTnaReason}" editable="{= !!${vm>/appraisal/tnaEdit} }" placeholder="Reason (required)" liveChange=".onApDirty"/>
								</VBox>
							</VBox>
						</VBox>
					</uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
				</uxap:ObjectPageSection>

				<uxap:ObjectPageSection id="sec-summary" title="{vm>/appraisal/sec/summary}">
					<uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
						<VBox class="tsSecBlock" renderType="Bare">
							<HBox class="tsGap" alignItems="Center" wrap="Wrap" renderType="Bare">
								<VBox alignItems="Center" renderType="Bare">
									<mc:RadialMicroChart size="L" total="5" fraction="{form>/ap/calc/big}" valueColor="Good" visible="{= !!${form>/ap/calc/has} }"/>
									<Title text="{form>/ap/calc/bigText} of 5" level="H2"/>
								</VBox>
								<VBox class="tsGapS" renderType="Bare">
									<Text text="{form>/ap/calc/kind}" class="tsMeta"/>
									<Title text="{form>/ap/calc/label}" level="H2"/>
									<Text visible="{= !!${form>/ap/calc/why} }" text="{form>/ap/calc/why}"/>
									<Text text="{form>/ap/calc/rule}" class="tsMeta"/>
									<HBox class="tsGapS" renderType="Bare"><Label text="Performance objectives · 100% · score"/><Text text="{form>/ap/calc/comp}"/></HBox>
									<HBox class="tsGapS" renderType="Bare"><Label text="Training needs assessment · not scored"/></HBox>
								</VBox>
							</HBox>
							<HBox class="tsGap" wrap="Wrap" renderType="Bare">
								<VBox class="tsGrow" renderType="Bare">
									<Label text="Employee summary" labelFor="empsum"/>
									<TextArea id="empsum" visible="{= !!${vm>/appraisal/empSumShow} }" width="100%" rows="4" maxLength="2000" editable="{= !!${vm>/appraisal/empSumEdit} }" value="{form>/ap/empSum}" liveChange=".onApDirty"/>
									<Text visible="{= !${vm>/appraisal/empSumShow} }" text="Not submitted yet" class="tsMeta"/>
								</VBox>
								<VBox class="tsGrow" renderType="Bare">
									<Label text="Manager summary" labelFor="mgrsum" required="{= !!${vm>/appraisal/mgrSumEdit} }"/>
									<TextArea id="mgrsum" visible="{= !!${vm>/appraisal/mgrSumShow} }" width="100%" rows="4" maxLength="2000" editable="{= !!${vm>/appraisal/mgrSumEdit} }" value="{form>/ap/mgrSum}" liveChange=".onApDirty"/>
									<Text visible="{= !${vm>/appraisal/mgrSumShow} }" text="Shown at acknowledgement" class="tsMeta"/>
								</VBox>
							</HBox>
							<Panel visible="{= !!${vm>/appraisal/calShow} }" headerText="Calibration · visible to managers and HR only">
								<VBox class="tsGapS" renderType="Bare">
									<VBox visible="{= !!${vm>/appraisal/calEdit} }" class="tsGapS" renderType="Bare">
										<Label text="Calibrated rating (leave blank to keep the calculated rating)" labelFor="calr"/>
										<Select id="calr" width="18rem" selectedKey="{form>/ap/calRating}" items="{path: 'vm>/appraisal/calScale', templateShareable: false}" change=".onApRate"><core:Item key="{vm>key}" text="{vm>text}"/></Select>
										<Label text="Calibration note" labelFor="calnote"/>
										<TextArea id="calnote" width="100%" rows="3" value="{form>/ap/calNote}" liveChange=".onApDirty"/>
									</VBox>
									<Text visible="{= !${vm>/appraisal/calEdit} }" text="{vm>/appraisal/calRead}"/>
								</VBox>
							</Panel>
							<Panel visible="{= !!${vm>/appraisal/ackShow} }" headerText="Your acknowledgement">
								<VBox class="tsGapS" renderType="Bare">
									<Text text="{vm>/appraisal/ackText}"/>
									<TextArea value="{form>/ap/ackText}" width="100%" rows="3" maxLength="1000" placeholder="Reason for appeal (required to appeal)"/>
									<HBox class="tsGapS" renderType="Bare">
										<Button text="Acknowledge" type="Emphasized" press=".onApAck"><customData><core:CustomData key="d" value="accept"/></customData></Button>
										<Button text="Appeal to HR" visible="{= !!${vm>/appraisal/canAppealBtn} }" press=".onApAck"><customData><core:CustomData key="d" value="appeal"/></customData></Button>
									</HBox>
								</VBox>
							</Panel>
							<Panel visible="{= !!${vm>/appraisal/appealShow} }" headerText="Appeal">
								<VBox class="tsGapS" renderType="Bare">
									<Text text="{vm>/appraisal/appealReason}"/>
									<VBox visible="{= !!${vm>/appraisal/appealEdit} }" class="tsGapS" renderType="Bare">
										<SegmentedButton selectedKey="{form>/ap/appealDecision}" selectionChange=".onApDirty">
											<items><SegmentedButtonItem key="uphold" text="Uphold the rating"/><SegmentedButtonItem key="revise" text="Revise the rating"/></items>
										</SegmentedButton>
										<Select visible="{= ${form>/ap/appealDecision} === 'revise' }" width="18rem" selectedKey="{form>/ap/appealRating}" items="{path: 'vm>/appraisal/apScale', templateShareable: false}" change=".onApDirty"><core:Item key="{vm>key}" text="{vm>text}"/></Select>
										<Label text="Decision note" labelFor="apnote" required="true"/>
										<TextArea id="apnote" width="100%" rows="3" value="{form>/ap/appealNote}" liveChange=".onApDirty"/>
									</VBox>
									<Text visible="{= !${vm>/appraisal/appealEdit} }" text="{vm>/appraisal/appealRead}"/>
								</VBox>
							</Panel>
						</VBox>
					</uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
				</uxap:ObjectPageSection>

				<uxap:ObjectPageSection id="sec-comments" title="{vm>/appraisal/sec/comments}">
					<uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
						<VBox class="tsSecBlock" renderType="Bare">
							<List items="{vm>/appraisal/comments}" noDataText="No comments yet."><StandardListItem title="{vm>text}" wrapping="true"/></List>
							<HBox visible="{= !!${vm>/appraisal/canAdd} }" class="tsGapS" renderType="Bare">
								<Input value="{form>/ap/newComment}" maxLength="500" placeholder="Add a comment for everyone who can open this form" submit=".onApComment"><layoutData><FlexItemData growFactor="1"/></layoutData></Input>
								<Button text="Add" press=".onApComment"/>
							</HBox>
						</VBox>
					</uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
				</uxap:ObjectPageSection>

				<uxap:ObjectPageSection id="sec-attachments" title="{vm>/appraisal/sec/attachments}">
					<uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
						<VBox class="tsSecBlock" renderType="Bare">
							<Text text="Only the file name and size are kept in this prototype; files are not uploaded or stored." class="tsMeta"/>
							<List items="{vm>/appraisal/files}" noDataText="No attachments."><StandardListItem title="{vm>text}" wrapping="true"/></List>
							<unified:FileUploader visible="{= !!${vm>/appraisal/canAdd} }" buttonOnly="true" buttonText="Add file" icon="sap-icon://attachment" multiple="false" change=".onApFile"/>
						</VBox>
					</uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
				</uxap:ObjectPageSection>

				<uxap:ObjectPageSection id="sec-history" title="{vm>/appraisal/sec/history}">
					<uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
						<VBox class="tsSecBlock" renderType="Bare">
							<List items="{vm>/appraisal/hist}"><StandardListItem title="{vm>text}" wrapping="true"/></List>
						</VBox>
					</uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
				</uxap:ObjectPageSection>
			</uxap:sections>
		</uxap:ObjectPageLayout>
	</VBox>
	<mvc:dependents>
		<Dialog id="retDlg" title="Return for revision" contentWidth="30rem">
			<VBox class="tsPad tsGapS" renderType="Bare">
				<Label text="Say what needs to change" labelFor="retmsg" required="true"/>
				<TextArea id="retmsg" value="{form>/ap/ret}" rows="4" width="100%" maxLength="500"/>
			</VBox>
			<beginButton><Button text="Return" type="Emphasized" press=".onApReturn"/></beginButton>
			<endButton><Button text="Cancel" press=".onApReturnCancel"/></endButton>
		</Dialog>
	</mvc:dependents>
</mvc:View>
