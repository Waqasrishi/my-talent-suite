<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:breadcrumbs><Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs></f:breadcrumbs>
			<f:heading><Title text="{vm>/devRecord/title}" wrapping="true"/></f:heading>
			<f:expandedContent><Label text="{vm>/devRecord/sub}" wrapping="true"/></f:expandedContent>
			<f:snappedContent><Label text="{vm>/devRecord/sub}"/></f:snappedContent>
			<f:actions></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<VBox height="26rem" visible="{= !!${vm>/devRecord/denied} }"><MessagePage showHeader="false" text="{vm>/devRecord/title}" description="{vm>/devRecord/msg}" icon="sap-icon://locked"><buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons></MessagePage></VBox>
				<VBox visible="{= !${vm>/devRecord/denied} }" renderType="Bare" class="tsGap">

					<f:Card>
						<f:content>
							<VBox class="tsPad" width="100%" renderType="Bare">
								<VBox items="{vm>/devRecord/kv}"><HBox class="tsKv" renderType="Bare"><Label text="{vm>k}"/><Text text="{vm>v}"/></HBox></VBox>
								<VBox visible="{= !!${vm>/devRecord/canStatus} }" class="sapUiSmallMarginTop" renderType="Bare">
									<Label text="Update status" labelFor="dvst"/>
									<Select id="dvst" width="14rem" selectedKey="{vm>/devRecord/status}" items="{vm>/devRecord/statuses}" change=".onDevStatus"><core:Item key="{vm>key}" text="{vm>text}"/></Select>
								</VBox>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="Learning" iconSrc="sap-icon://course-book"/></f:header>
						<f:content>
							<VBox class="tsPad" width="100%" renderType="Bare">
								<HBox visible="{= !!${vm>/devRecord/learn} }" class="tsGapS" renderType="Bare"><Link text="{vm>/devRecord/learn/text}" press=".onHref"><customData><core:CustomData key="href" value="{vm>/devRecord/learn/href}"/></customData></Link><Text text="· {vm>/devRecord/learn/sub}"/></HBox>
								<Text visible="{= !${vm>/devRecord/learn} }" text="No catalogue course is linked. The intervention is described in the expected outcome."/>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="Source" iconSrc="sap-icon://history"/></f:header>
						<f:content>
							<VBox class="tsPad" width="100%" renderType="Bare">
								<Link visible="{= !!${vm>/devRecord/source} }" text="{vm>/devRecord/source/text}" press=".onHref"><customData><core:CustomData key="href" value="{vm>/devRecord/source/href}"/></customData></Link>
								<Text visible="{= !${vm>/devRecord/source} }" text="The source appraisal is not available to you."/>
								<List items="{vm>/devRecord/hist}"><StandardListItem title="{vm>text}" wrapping="true"/></List>
							</VBox>
						</f:content>
					</f:Card>
				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>