<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:breadcrumbs><Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs></f:breadcrumbs>
			<f:heading><Title text="{vm>/development/title}" wrapping="true"/></f:heading>
			<f:expandedContent><Label text="{vm>/development/sub}" wrapping="true"/></f:expandedContent>
			<f:snappedContent><Label text="{vm>/development/sub}"/></f:snappedContent>
			<f:actions></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<VBox height="26rem" visible="{= !!${vm>/development/denied} }"><MessagePage showHeader="false" text="{vm>/development/title}" description="{vm>/development/msg}" icon="sap-icon://locked"><buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons></MessagePage></VBox>
				<VBox visible="{= !${vm>/development/denied} }" renderType="Bare" class="tsGap">

					<f:Card>
						<f:header><card:Header title="Training Needs Assessment plan" subtitle="Agreed with your manager in your appraisal." iconSrc="sap-icon://education"/></f:header>
						<f:content><List items="{vm>/development/rows}" noDataText="None yet.">
							<CustomListItem type="Navigation" press=".onHref">
								<HBox class="sapUiSmallMargin" alignItems="Center" wrap="Wrap" renderType="Bare">
									<VBox class="tsRowMain"><Title text="{vm>area}" titleStyle="H6"/><Text text="{vm>sub}" class="tsMeta"/></VBox>
									<ObjectStatus text="{vm>status}" state="{= ${vm>status} === 'Completed' ? 'Success' : ${vm>status} === 'In progress' ? 'Warning' : 'None' }" inverted="true"/>
									<Text text="{vm>source}" class="tsMeta sapUiSmallMarginBegin"/>
								</HBox>
							</CustomListItem>
						</List></f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="Career development plan" iconSrc="sap-icon://career-path"/></f:header>
						<f:content><HBox class="tsPad tsGapS" renderType="Bare"><ObjectStatus text="Not configured" state="Warning" inverted="true"/><Text text="Career development plans are not set up in this platform yet."/></HBox></f:content>
					</f:Card>
				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>