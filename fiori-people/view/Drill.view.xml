<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:breadcrumbs><Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs></f:breadcrumbs>
			<f:heading><Title text="{vm>/drill/title}" wrapping="true"/></f:heading>
			<f:expandedContent><Label text="{vm>/drill/sub}" wrapping="true"/></f:expandedContent>
			<f:snappedContent><Label text="{vm>/drill/sub}"/></f:snappedContent>
			<f:actions>
				<Button text="← Back to reports" press=".onHref"><customData><core:CustomData key="href" value="#/reports"/></customData></Button>
</f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<VBox height="26rem" visible="{= !!${vm>/drill/denied} }"><MessagePage showHeader="false" text="{vm>/drill/title}" description="{vm>/drill/msg}" icon="sap-icon://locked"><buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons></MessagePage></VBox>
				<VBox visible="{= !${vm>/drill/denied} }" renderType="Bare" class="tsGap">

					<List visible="{= !!${vm>/drill/isGoals} }" items="{vm>/drill/goals}" noDataText="No records."><core:Fragment fragmentName="ajmn.people.view.GoalRowAll" type="XML"/></List>
					<List visible="{= !${vm>/drill/isGoals} }" items="{vm>/drill/aps}" noDataText="No records.">
						<CustomListItem type="Navigation" press=".onHref">
							<HBox class="sapUiSmallMargin" alignItems="Center" wrap="Wrap" renderType="Bare">
								<VBox class="tsRowMain"><Title text="{vm>name}" titleStyle="H6"/><Text text="{vm>title}" class="tsMeta"/></VBox>
								<ObjectStatus text="{vm>step}" state="{vm>stepState}" inverted="true"/>
								<Text text="{vm>due}" class="tsMeta sapUiSmallMarginBegin"/>
							</HBox>
						</CustomListItem>
					</List>

				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>