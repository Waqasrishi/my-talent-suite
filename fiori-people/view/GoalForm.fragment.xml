<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="gfDlg" title="{form>/gform/heading}" contentWidth="46rem" contentHeight="85%" draggable="true" resizable="true">
		<content>
			<VBox class="tsPad tsGap" renderType="Bare">
				<MessageStrip visible="{= !!${form>/gform/approvedNote} }" type="Information" showIcon="true"
					text="Saving sends it to your manager for approval again, and the owners of goals aligned to it are asked to review theirs."/>
				<Text visible="{= !!${form>/gform/isEdit} }" text="Alignment is managed on the goal itself." class="tsMeta"/>
				<VBox visible="{= !${form>/gform/isEdit} }" renderType="Bare">
					<Label text="Supports (main outbound alignment)" labelFor="fTo" required="true"/>
					<Select id="fTo" width="100%" selectedKey="{form>/gform/to}" items="{form>/gform/toOpts}" forceSelection="false"
						valueState="{= ${form>/gform/err/to} ? 'Error' : 'None' }" valueStateText="{form>/gform/err/to}">
						<core:Item key="{form>key}" text="{form>text}"/>
					</Select>
					<Text text="{form>/gform/toHint}" class="tsMeta"/>
				</VBox>
				<VBox renderType="Bare">
					<Label text="Goal" labelFor="fTitle" required="true"/>
					<Input id="fTitle" value="{form>/gform/title}" maxLength="200" placeholder="An outcome, for example: Cut playout incidents to under three a month"
						valueState="{= ${form>/gform/err/title} ? 'Error' : 'None' }" valueStateText="{form>/gform/err/title}"/>
				</VBox>
				<HBox class="tsForm" renderType="Bare">
					<VBox class="tsField"><Label text="Type" labelFor="fType"/><Select id="fType" width="100%" selectedKey="{form>/gform/type}" items="{form>/gform/typeOpts}"><core:Item key="{form>key}" text="{form>text}"/></Select></VBox>
					<VBox class="tsField"><Label text="Due date" labelFor="fDue"/>
						<DatePicker id="fDue" value="{form>/gform/due}" valueFormat="yyyy-MM-dd" displayFormat="medium" width="100%" valueState="{= ${form>/gform/err/due} ? 'Error' : 'None' }" valueStateText="{form>/gform/err/due}"/></VBox>
					<VBox class="tsField"><Label text="Weight in your goals %" labelFor="fWeight"/>
						<Input id="fWeight" value="{form>/gform/weight}" type="Number" placeholder="optional" valueState="{= ${form>/gform/err/weight} ? 'Error' : 'None' }" valueStateText="{form>/gform/err/weight}"/></VBox>
				</HBox>

				<VBox class="tsAi" renderType="Bare">
					<HBox class="tsWrap" alignItems="Center" renderType="Bare">
						<Button text="Suggest goals for me" icon="sap-icon://ai" type="Transparent" press=".onAiSuggest"/>
						<Button text="Review my draft" icon="sap-icon://ai" type="Transparent" press=".onAiReview"/>
						<Input value="{form>/gform/hint}" placeholder="Priorities, in a few words (optional)" maxLength="120" width="18rem"/>
					</HBox>
					<VBox visible="{= !!${form>/gform/ai} }" renderType="Bare" class="tsGapS">
						<ObjectStatus text="Prototype · scripted, not from a model" state="Information" icon="sap-icon://ai"/>
						<VBox visible="{= ${form>/gform/ai/kind} === 'suggest' }" items="{form>/gform/ai/items}" class="tsGapS">
							<VBox class="tsNext" renderType="Bare">
								<Title text="{form>title}" level="H4" wrapping="true"/>
								<VBox items="{path: 'form>lines', templateShareable: false}"><Text text="• {form>}"/></VBox>
								<Text text="{form>why}" class="tsMeta"/>
								<HBox><Button text="Use this" press=".onAiUse"/></HBox>
							</VBox>
						</VBox>
						<VBox visible="{= ${form>/gform/ai/kind} === 'review' }" items="{form>/gform/ai/checks}">
							<HBox class="sapUiTinyMarginBottom" renderType="Bare">
								<ObjectStatus icon="{form>icon}" state="{form>state}" text=""/>
								<VBox><Text text="{form>label}"/><Text visible="{= !!${form>tip} }" text="{form>tip}" class="tsMeta"/></VBox>
							</HBox>
						</VBox>
						<HBox><Button text="Hide" type="Transparent" press=".onAiClose"/></HBox>
					</VBox>
				</VBox>

				<VBox renderType="Bare">
					<Label text="Progress comes from"/>
					<SegmentedButton selectedKey="{form>/gform/rollup}">
						<items><SegmentedButtonItem key="krs" text="Its key results"/><SegmentedButtonItem key="aligned" text="The goals aligned to it"/></items>
					</SegmentedButton>
				</VBox>
				<Label text="Key results"/>
				<MessageStrip visible="{= !!${form>/gform/err/krs} }" type="Error" showIcon="true" text="{form>/gform/err/krs}"/>
				<VBox items="{form>/gform/krs}" class="tsGapS">
					<VBox class="tsNext" renderType="Bare">
						<HBox class="tsGapS" alignItems="Center" renderType="Bare">
							<Input value="{form>t}" maxLength="200" placeholder="Key result, for example: Newsletter sign-ups">
								<layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
							</Input>
							<Select selectedKey="{form>type}">
								<core:Item key="number" text="Number"/><core:Item key="binary" text="Done / not done"/><core:Item key="milestone" text="Milestones"/>
							</Select>
							<Button icon="sap-icon://decline" type="Transparent" tooltip="Remove" visible="{= ${form>/gform/krs}.length > 1 }" press=".onKrDel"/>
						</HBox>
						<HBox visible="{= ${form>type} === 'number' }" class="tsWrap" renderType="Bare">
							<Input value="{form>start}" type="Number" placeholder="Start" width="7rem"/>
							<Input value="{form>target}" type="Number" placeholder="Target" width="7rem"/>
							<Input value="{form>current}" type="Number" placeholder="Current (optional)" width="10rem"/>
							<Input value="{form>unit}" maxLength="20" placeholder="Unit: %, QAR, minutes" width="10rem"/>
						</HBox>
						<TextArea visible="{= ${form>type} === 'milestone' }" value="{form>steps}" rows="3" width="100%" placeholder="Steps, one per line"/>
						<Text visible="{= ${form>type} === 'binary' }" text="Counts as 0% until it is done, then 100%." class="tsMeta"/>
						<Input value="{form>weight}" type="Number" placeholder="Weight % (blank counts equally)" width="14rem"/>
						<Text visible="{= !!${form>err} }" text="{form>err}"/>
					</VBox>
				</VBox>
				<HBox><Button text="+ Add another" type="Transparent" visible="{= !!${form>/gform/canAddKr} }" press=".onKrAdd"/></HBox>
				<Label text="Description" labelFor="fDesc"/>
				<TextArea id="fDesc" value="{form>/gform/desc}" rows="3" width="100%" maxLength="1000"/>
			</VBox>
		</content>
		<buttons>
			<Button text="{form>/gform/submitText}" type="Emphasized" press=".onFormSave"/>
			<Button text="Save draft" visible="{= !!${form>/gform/canDraft} }" press=".onFormSave"><customData><core:CustomData key="draft" value="true"/></customData></Button>
			<Button text="Cancel" press=".onFormCancel"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
