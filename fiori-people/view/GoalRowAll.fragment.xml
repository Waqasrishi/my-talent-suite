<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<CustomListItem type="Navigation" press=".onGoalOpen">
		<HBox class="sapUiSmallMargin" alignItems="Center" wrap="Wrap" renderType="Bare">
			<VBox class="tsRowMain">
				<HBox class="tsGapS" alignItems="Center" renderType="Bare"><Title text="{vm>title}" titleStyle="H6" wrapping="true"/><ObjectStatus visible="{vm>archived}" text="Archived" state="None" inverted="true"/></HBox>
				<Text text="{vm>ownerLine}" class="tsMeta"/>
			</VBox>
			<Text text="Due {vm>due}" class="tsMeta" wrapping="false"/>
			<ProgressIndicator class="tsRowProg" percentValue="{vm>pct}" displayValue="{vm>pctText}" state="{vm>barState}" displayOnly="true"/>
			<HBox class="tsGapS" renderType="Bare">
				<ObjectStatus text="{vm>status}" state="{vm>statusState}" inverted="true"/>
				<ObjectStatus visible="{vm>hasHealth}" text="{vm>health}" state="{vm>healthState}" inverted="true"/>
			</HBox>
		</HBox>
	</CustomListItem>
</core:FragmentDefinition>
