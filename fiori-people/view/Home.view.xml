<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:breadcrumbs><Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs></f:breadcrumbs>
			<f:heading><Title text="{vm>/home/title}" wrapping="true"/></f:heading>
			<f:expandedContent><Label text="{vm>/home/sub}" wrapping="true"/></f:expandedContent>
			<f:snappedContent><Label text="{vm>/home/sub}"/></f:snappedContent>
			<f:actions></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<VBox height="26rem" visible="{= !!${vm>/home/denied} }"><MessagePage showHeader="false" text="{vm>/home/title}" description="{vm>/home/msg}" icon="sap-icon://locked"><buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons></MessagePage></VBox>
				<VBox visible="{= !${vm>/home/denied} }" renderType="Bare" class="tsGap">

					<VBox class="tsHero" renderType="Bare">
						<Label class="tsHeroEyebrow" text="{vm>/home/greet}"/>
						<Text class="tsHeroTitle" text="Your contribution. Our shared impact."/>
						<Text text="Connect your goals, performance, and development to the future of Al Jazeera."/>
						<HBox class="tsWrap sapUiSmallMarginTop" items="{vm>/home/hero}"><Button text="{vm>text}" type="{vm>type}" press=".onHref"/></HBox>
					</VBox>
					<VBox renderType="Bare" class="tsGapS">
						<Title text="Quick actions" level="H3"/>
						<HBox class="tsWrap" items="{vm>/home/qa}"><Button text="{vm>text}" icon="{vm>icon}" enabled="{vm>enabled}" tooltip="{vm>why}" press=".onHref"/></HBox>
					</VBox>
					<HBox justifyContent="SpaceBetween" alignItems="End" renderType="Bare">
						<VBox renderType="Bare"><Title text="Needs Attention" level="H2"/><Text text="Items that need your action · {vm>/home/cycle}" class="tsMeta"/></VBox>
						<Link text="View all ({vm>/home/naCount}) →" press=".onHref"><customData><core:CustomData key="href" value="#/approvals"/></customData></Link>
					</HBox>
					<Text visible="{= ${vm>/home/naCount} === 0 }" text="Nothing needs your action right now."/>
					<grid:CSSGrid gridTemplateColumns="repeat(auto-fill, minmax(19rem, 1fr))" gridGap="1rem" items="{vm>/home/na}">
						<f:Card>
							<f:header><card:Header title="{vm>obj}" subtitle="{vm>type}" iconSrc="{vm>icon}" statusText="{vm>state}"/></f:header>
							<f:content>
								<VBox class="tsPad tsGapS" width="100%" renderType="Bare">
									<Text text="{vm>who}"/>
									<HBox class="tsWrap" renderType="Bare">
										<ObjectStatus text="{vm>cycle}" state="None" inverted="true"/>
										<ObjectStatus text="{vm>due}" state="{= ${vm>late} ? 'Error' : 'None' }" inverted="true"/>
									</HBox>
									<HBox><Button text="{vm>act} →" type="Emphasized" press=".onHref"/></HBox>
								</VBox>
							</f:content>
						</f:Card>
					</grid:CSSGrid>
					<VBox renderType="Bare"><Title text="Explore and Take Action" level="H2"/><Text text="Everything in one place. Areas that are not set up yet say so." class="tsMeta"/></VBox>
					<grid:CSSGrid gridTemplateColumns="repeat(auto-fill, minmax(19rem, 1fr))" gridGap="1rem" items="{vm>/home/tiles}">
						<f:Card>
							<f:header><card:Header title="{vm>text}" subtitle="{vm>desc}" iconSrc="{vm>icon}" statusText="{vm>foot}" press=".onTile"/></f:header>
						</f:Card>
					</grid:CSSGrid>

				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>