<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:breadcrumbs><Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs></f:breadcrumbs>
			<f:heading><Title text="{vm>/learning/title}" wrapping="true"/></f:heading>
			<f:expandedContent><Label text="{vm>/learning/sub}" wrapping="true"/></f:expandedContent>
			<f:snappedContent><Label text="{vm>/learning/sub}"/></f:snappedContent>
			<f:actions></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<VBox height="26rem" visible="{= !!${vm>/learning/denied} }"><MessagePage showHeader="false" text="{vm>/learning/title}" description="{vm>/learning/msg}" icon="sap-icon://locked"><buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons></MessagePage></VBox>
				<VBox visible="{= !${vm>/learning/denied} }" renderType="Bare" class="tsGap">

					<grid:CSSGrid gridTemplateColumns="repeat(auto-fill, minmax(19rem, 1fr))" gridGap="1rem" items="{vm>/learning/rows}">
						<f:Card><f:header><card:Header title="{vm>text}" subtitle="{vm>desc}" iconSrc="sap-icon://course-book" statusText="Sample" press=".onHref"/></f:header></f:Card>
					</grid:CSSGrid>
				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>