<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<ResponsivePopover title="{vm>/sh/me/name}" placement="Bottom" contentWidth="24rem">
		<VBox class="tsPad tsGapS" renderType="Bare">
			<Text text="{vm>/sh/me/title} · {vm>/sh/me/dept}"/>
			<Text text="{vm>/sh/me/line}" class="tsMeta"/>
			<Label text="Switch demo persona (not secure sign-in)" labelFor="persona" class="sapUiSmallMarginTop"/>
			<Select id="persona" width="100%" selectedKey="{vm>/sh/me/id}" items="{vm>/sh/personas}" change=".onPersona">
				<core:Item key="{vm>key}" text="{vm>text}"/>
			</Select>
			<Label text="Review cycle" labelFor="cycle"/>
			<Select id="cycle" width="100%" selectedKey="{vm>/sh/cycle}" items="{vm>/sh/cycles}" change=".onCycle">
				<core:Item key="{vm>key}" text="{vm>text}"/>
			</Select>
			<HBox class="sapUiSmallMarginTop"><Button text="Reset demo data" icon="sap-icon://reset" type="Transparent" press=".onReset"/></HBox>
		</VBox>
	</ResponsivePopover>
</core:FragmentDefinition>
