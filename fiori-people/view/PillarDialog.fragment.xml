<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="pilDlg" title="Pillar" contentWidth="34rem" draggable="true">
		<content>
			<VBox class="tsPad tsGap" renderType="Bare">
				<ObjectStatus text="Pillar" state="Success" inverted="true"/>
				<Title text="{form>/pil/name}" level="H2" wrapping="true"/>
				<VBox visible="{= !!${form>/pil/canEdit} }" class="tsGapS" renderType="Bare">
					<Label text="Pillar name" labelFor="pName"/>
					<HBox class="tsGapS" renderType="Bare"><Input id="pName" value="{form>/pil/name}" maxLength="120"><layoutData><FlexItemData growFactor="1"/></layoutData></Input><Button text="Save" press=".onPillarRename"/></HBox>
					<VBox visible="{= !!${form>/pil/canGoal} }" class="tsNext" renderType="Bare">
						<Title text="Add a goal under this pillar" level="H3"/>
						<Text text="It becomes one of your goals as {form>/pil/role}."/>
						<HBox><Button text="Create Goal" type="Emphasized" press=".onPillarGoal"/></HBox>
					</VBox>
				</VBox>
				<Text visible="{= !${form>/pil/canEdit} }" text="Pillars are managed by the Executive Directors." class="tsMeta"/>
				<Title text="{form>/pil/goalsTitle}" level="H3"/>
				<List items="{form>/pil/goals}" noDataText="None yet.">
					<StandardListItem title="{form>text}" type="Active" wrapping="true" press=".onPillarGoalOpen"/>
				</List>
				<Panel visible="{= !!${form>/pil/canEdit} }" headerText="Add a pillar" expandable="true" expanded="false">
					<HBox class="tsGapS" renderType="Bare"><Input value="{form>/pil/newName}" maxLength="120" placeholder="Pillar name"><layoutData><FlexItemData growFactor="1"/></layoutData></Input><Button text="Add" press=".onPillarAdd"/></HBox>
				</Panel>
			</VBox>
		</content>
		<endButton><Button text="Close" press=".onPillarClose"/></endButton>
	</Dialog>
</core:FragmentDefinition>
