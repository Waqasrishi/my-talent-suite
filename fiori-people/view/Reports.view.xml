<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:breadcrumbs><Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs></f:breadcrumbs>
			<f:heading><Title text="{vm>/reports/title}" wrapping="true"/></f:heading>
			<f:expandedContent><Label text="{vm>/reports/sub}" wrapping="true"/></f:expandedContent>
			<f:snappedContent><Label text="{vm>/reports/sub}"/></f:snappedContent>
			<f:actions>
				<SegmentedButton visible="{= !!${vm>/reports/isEd} }" selectedKey="{vm>/reports/scope}" selectionChange=".onScope">
					<items><SegmentedButtonItem key="all" text="Everyone"/><SegmentedButtonItem key="team" text="My organisation"/></items>
				</SegmentedButton>
</f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<VBox height="26rem" visible="{= !!${vm>/reports/denied} }"><MessagePage showHeader="false" text="{vm>/reports/title}" description="{vm>/reports/msg}" icon="sap-icon://locked"><buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons></MessagePage></VBox>
				<VBox visible="{= !${vm>/reports/denied} }" renderType="Bare" class="tsGap">

					<grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(16rem, 1fr))" gridGap="1rem" items="{vm>/reports/stats}">
						<f:Card>
							<f:header><card:Header title="{vm>n}" subtitle="{vm>text}" press=".onHref"/></f:header>
						</f:Card>
					</grid:CSSGrid>
					<f:Card>
						<f:header><card:Header title="Appraisal progress" iconSrc="sap-icon://survey"/></f:header>
						<f:content><HBox class="tsWrap tsPad" width="100%" items="{vm>/reports/apSteps}"><ObjectStatus text="{vm>text}" state="{vm>state}" inverted="true" active="true" press=".onHref"/></HBox></f:content>
					</f:Card>
					<f:Card>
						<f:header><card:Header title="Health of approved goals" subtitle="{vm>/reports/healthNote}" iconSrc="sap-icon://pulse"/></f:header>
						<f:content><HBox class="tsWrap tsPad" width="100%" items="{vm>/reports/health}"><ObjectStatus text="{vm>text}" state="{vm>state}" inverted="true" active="true" press=".onHref"/></HBox></f:content>
					</f:Card>
					<grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(22rem, 1fr))" gridGap="1rem">
						<f:Card>
							<f:header><card:Header title="Coverage by level" subtitle="People with an approved goal" iconSrc="sap-icon://group"/></f:header>
							<f:content>
								<List items="{vm>/reports/levels}">
									<CustomListItem type="Navigation" press=".onHref">
										<HBox class="sapUiSmallMargin" alignItems="Center" renderType="Bare"><Text text="{vm>text}" width="11rem"/><ProgressIndicator percentValue="{vm>pct}" displayValue="{vm>n}" displayOnly="true" state="Information"><layoutData><FlexItemData growFactor="1"/></layoutData></ProgressIndicator></HBox>
									</CustomListItem>
								</List>
							</f:content>
						</f:Card>
						<f:Card>
							<f:header><card:Header title="Progress by pillar" subtitle="Each goal counted once, through its main alignment" iconSrc="sap-icon://org-chart"/></f:header>
							<f:content>
								<List items="{vm>/reports/pillars}">
									<CustomListItem type="Navigation" press=".onHref">
										<HBox class="sapUiSmallMargin" alignItems="Center" renderType="Bare"><Text text="{vm>text}" width="11rem" wrapping="true"/><ProgressIndicator percentValue="{vm>pct}" displayValue="{vm>n}" displayOnly="true" state="Success"><layoutData><FlexItemData growFactor="1"/></layoutData></ProgressIndicator></HBox>
									</CustomListItem>
								</List>
							</f:content>
						</f:Card>
					</grid:CSSGrid>
					<HBox><Link text="{vm>/reports/unText}" press=".onHref"><customData><core:CustomData key="href" value="{vm>/reports/unHref}"/></customData></Link></HBox>

				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>