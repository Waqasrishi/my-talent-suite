<mvc:View controllerName="ajmn.people.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title><f:DynamicPageTitle>
			<f:breadcrumbs><Breadcrumbs visible="{= ${vm>/sh/crumbs/links}.length > 0 }" currentLocationText="{vm>/sh/crumbs/current}" links="{vm>/sh/crumbs/links}"><Link text="{vm>text}" press=".onCrumb"/></Breadcrumbs></f:breadcrumbs>
			<f:heading><Title text="{vm>/strategy/title}" wrapping="true"/></f:heading>
			<f:expandedContent><Label text="{vm>/strategy/sub}" wrapping="true"/></f:expandedContent>
			<f:snappedContent><Label text="{vm>/strategy/sub}"/></f:snappedContent>
			<f:actions></f:actions>
		</f:DynamicPageTitle></f:title>
		<f:content>
			<VBox renderType="Bare">
				<VBox height="26rem" visible="{= !!${vm>/strategy/denied} }"><MessagePage showHeader="false" text="{vm>/strategy/title}" description="{vm>/strategy/msg}" icon="sap-icon://locked"><buttons><Button text="Back to Home" type="Emphasized" press=".onHome"/></buttons></MessagePage></VBox>
				<VBox visible="{= !${vm>/strategy/denied} }" renderType="Bare" class="tsGap">

					<MessageStrip visible="{= !!${vm>/strategy/banner} }" type="{vm>/strategy/bannerType}" showIcon="true" text="{vm>/strategy/banner}">
						<link><Link text="Show everything" visible="{= !!${vm>/strategy/showAll} }" press=".onShowAll"/></link>
					</MessageStrip>
					<core:HTML content="{vm>/strategy/html}" afterRendering=".onMapRendered" preferDOM="false"/>
					<HBox class="tsLegend" renderType="Bare">
						<ObjectStatus text="Pillar" state="Information" icon="sap-icon://color-fill"/>
						<ObjectStatus text="Approved goal" state="None" icon="sap-icon://color-fill"/>
						<ObjectStatus text="Waiting for approval" state="Warning" icon="sap-icon://color-fill"/>
						<ObjectStatus text="Not aligned" state="Error" icon="sap-icon://color-fill"/>
						<Text text="Drafts and archived goals are not shown." class="tsMeta"/>
					</HBox>

				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>