<mvc:View controllerName="ajmn.talent.controller.Main" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards"
	xmlns:grid="sap.ui.layout.cssgrid" xmlns:dnd="sap.ui.core.dnd">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{vm>/perf/title}" wrapping="true"/></f:heading>
				<f:expandedContent><Label text="{vm>/perf/eyebrow}"/></f:expandedContent>
				<f:snappedContent><Label text="{vm>/perf/eyebrow}"/></f:snappedContent>
				<f:actions>
					<ObjectStatus text="{vm>/t/sample}" inverted="true" state="Information" icon="sap-icon://lab"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<IconTabBar selectedKey="{vm>/perf/tab}" select=".onTab" expandable="false" applyContentPadding="false" class="sapUiNoContentPadding">
				<customData><core:CustomData key="area" value="performance"/></customData>
				<items>
					<IconTabFilter key="reviews" text="{vm>/t/reviews}" icon="sap-icon://survey">
						<VBox renderType="Bare" class="sapUiSmallMarginTop tsGap">
							<IllustratedMessage visible="{= ${vm>/perf/mode} === 'deny' }" illustrationType="sapIllus-UnableToLoad" title="{vm>/t/denied}" description="{vm>/perf/denyText}">
								<additionalContent><Button text="Back to home" press=".onHome"/></additionalContent>
							</IllustratedMessage>
							<MessageStrip visible="{= ${vm>/perf/mode} === 'admin' }" showIcon="true" text="Cycle administration. Talent admins run cycles: dates, route and reminders. Review content is outside this role. Change the route in Configuration."/>
							<f:Card visible="{= ${vm>/perf/mode} === 'exec' }">
								<f:header><card:Header title="Rating distribution · News" subtitle="Executives see summaries, not individual forms." iconSrc="sap-icon://horizontal-bar-chart"/></f:header>
								<f:content>
									<VBox class="tsPad" width="100%" renderType="Bare">
										<VBox items="{vm>/perf/dist}">
											<VBox class="tsBar">
												<HBox justifyContent="SpaceBetween"><Text text="{vm>label}"/><Text text="{vm>n}"/></HBox>
												<ProgressIndicator percentValue="{vm>pct}" showValue="false" state="{vm>state}" displayOnly="true"/>
											</VBox>
										</VBox>
										<Text class="tsMeta" text="Groups under 5 are suppressed in division views. Shown here at team level for the sandbox."/>
									</VBox>
								</f:content>
							</f:Card>
							<Table contextualWidth="Auto" visible="{= ${vm>/perf/mode} === 'list' || ${vm>/perf/mode} === 'admin' }" items="{vm>/perf/table}">
								<headerToolbar><OverflowToolbar><Title text="{= ${vm>/perf/mode} === 'admin' ? 'Review cycle' : 'Reviews in your scope' }" level="H2"/><ToolbarSpacer/><Text text="{vm>/perf/routeText}" class="tsMeta"/></OverflowToolbar></headerToolbar>
								<columns>
									<Column><Text text="Person"/></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Role"/></Column>
									<Column><Text text="Step"/></Column>
									<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Overall"/></Column>
									<Column width="6rem" hAlign="End"><Text text=""/></Column>
								</columns>
								<ColumnListItem vAlign="Middle">
									<ObjectIdentifier title="{vm>name}"/><Text text="{vm>title}"/>
									<ObjectStatus text="{vm>step}" state="{vm>state}" inverted="true"/>
									<Text text="{vm>overall}"/>
									<Button text="Open" type="Ghost" visible="{vm>/perf/showOpen}" press=".onOpenRev"/>
								</ColumnListItem>
							</Table>
							<f:Card visible="{= ${vm>/perf/mode} === 'form' }">
								<f:header><card:Header title="{vm>/perf/form/name}" subtitle="{vm>/perf/form/meta}" iconInitials="{vm>/perf/form/initials}" iconDisplayShape="Circle"/></f:header>
								<f:content>
									<VBox class="tsPad tsGap" width="100%" renderType="Bare">
										<HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
											<HBox class="tsSteps" renderType="Bare" items="{vm>/perf/form/steps}">
												<ObjectStatus text="{vm>text}" state="{vm>state}" icon="{vm>icon}" inverted="true"/>
											</HBox>
											<Button text="All reviews" icon="sap-icon://nav-back" type="Transparent" visible="{vm>/perf/form/canClose}" press=".onCloseRev"/>
										</HBox>
										<Table contextualWidth="Auto" items="{vm>/perf/form/rows}">
											<columns>
												<Column><Text text="Item"/></Column>
												<Column width="30%"><Text text="Self"/></Column>
												<Column width="30%"><Text text="Manager"/></Column>
											</columns>
											<ColumnListItem vAlign="Middle" highlight="{= ${vm>kind} === 'overall' ? 'Information' : 'None' }">
												<HBox class="tsGapS" renderType="Bare" alignItems="Center">
													<Label text="{vm>label}" wrapping="true" design="{= ${vm>kind} === 'head' || ${vm>kind} === 'overall' ? 'Bold' : 'Standard' }"/>
													<Text text="{vm>meta}" class="tsMeta" wrapping="false" visible="{= !!${vm>meta} }"/>
												</HBox>
												<Select width="100%" visible="{= ${vm>kind} !== 'head' }" enabled="{vm>/perf/form/editSelf}" selectedKey="{vm>self}" items="{path: 'vm>opts', templateShareable: false}"><core:Item key="{vm>key}" text="{vm>text}"/></Select>
												<VBox visible="{= ${vm>kind} !== 'head' }">
													<Select width="100%" visible="{vm>/perf/form/showMgr}" enabled="{vm>/perf/form/editMgr}" selectedKey="{vm>mgr}" items="{path: 'vm>opts', templateShareable: false}"><core:Item key="{vm>key}" text="{vm>text}"/></Select>
													<ObjectStatus visible="{= !${vm>/perf/form/showMgr} }" text="Visible after release" state="Indication05" icon="sap-icon://locked"/>
												</VBox>
											</ColumnListItem>
										</Table>
										<HBox class="tsGap" wrap="Wrap" renderType="Bare">
											<VBox class="tsGrow"><Label text="Self comment" labelFor="selfC"/><TextArea id="selfC" width="100%" rows="4" value="{vm>/perf/form/selfComment}" editable="{vm>/perf/form/editSelf}"/></VBox>
											<VBox class="tsGrow"><Label text="Manager comment" labelFor="mgrC"/>
												<TextArea id="mgrC" width="100%" rows="4" visible="{vm>/perf/form/showMgr}" value="{vm>/perf/form/mgrComment}" editable="{vm>/perf/form/editMgr}"/>
												<ObjectStatus visible="{= !${vm>/perf/form/showMgr} }" text="Visible after release" state="Indication05" icon="sap-icon://locked"/>
											</VBox>
										</HBox>
										<MessageStrip visible="{= !!${vm>/perf/form/bandNote} }" text="{vm>/perf/form/bandNote}" showIcon="true"/>
										<HBox class="tsGapS" wrap="Wrap" alignItems="Center" renderType="Bare">
											<Button text="{vm>/perf/form/btnSelf}" type="Emphasized" visible="{vm>/perf/form/editSelf}" press=".onReview"><customData><core:CustomData key="by" value="self"/></customData></Button>
											<Button text="{vm>/perf/form/btnMgr}" type="Emphasized" visible="{vm>/perf/form/editMgr}" press=".onReview"><customData><core:CustomData key="by" value="mgr"/></customData></Button>
											<Button text="{vm>/perf/form/btnHr}" type="Emphasized" visible="{vm>/perf/form/canHr}" press=".onReview"><customData><core:CustomData key="by" value="hr"/></customData></Button>
											<Button text="{vm>/t/signoff}" type="Emphasized" visible="{vm>/perf/form/canSign}" press=".onReview"><customData><core:CustomData key="by" value="sign"/></customData></Button>
											<Button text="Create development item from this review" icon="sap-icon://learning-assistant" type="Accept" visible="{vm>/perf/form/canDev}" press=".onDevFromRev"/>
											<Button text="Reopen with reason" type="Ghost" visible="{vm>/perf/form/canReopen}" press=".onReopen"/>
											<Text text="{vm>/perf/form/waiting}" class="tsMeta" visible="{= !!${vm>/perf/form/waiting} }"/>
										</HBox>
										<VBox visible="{= !!${vm>/perf/form/aiDraft} }" class="tsAi" renderType="Bare">
											<ObjectStatus text="{vm>/t/aigen} · comment draft from evidence" state="Information" icon="sap-icon://ai"/>
											<Text text="{vm>/perf/form/aiDraft}"/>
											<Text class="tsMeta" text="From 3 feedback records and 3 goal records. Edit or discard before you use it."/>
										</VBox>
									</VBox>
								</f:content>
							</f:Card>
						</VBox>
					</IconTabFilter>
					<IconTabFilter key="feedback" text="{vm>/t/feedback}" icon="sap-icon://feedback">
						<grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(20rem, 1fr))" gridGap="1rem" class="sapUiSmallMarginTop">
							<f:Card class="tsCard">
								<f:header><card:Header title="Give or request feedback" iconSrc="sap-icon://feedback"/></f:header>
								<f:content>
									<VBox class="tsPad tsGapS" width="100%" renderType="Bare">
										<Label text="Type" labelFor="fbKind"/>
										<Select id="fbKind" width="100%" selectedKey="{form>/fb/kind}"><core:Item key="given" text="Give feedback"/><core:Item key="request" text="Request feedback"/></Select>
										<Label text="Colleague" labelFor="fbTo"/>
										<Select id="fbTo" width="100%" selectedKey="{form>/fb/to}" items="{vm>/perf/fb/people}"><core:Item key="{vm>key}" text="{vm>text}"/></Select>
										<Label text="Feedback" labelFor="fbText"/>
										<TextArea id="fbText" width="100%" rows="4" value="{form>/fb/text}" placeholder="Specific, recent, and linked to a goal where you can"/>
										<HBox><Button text="{vm>/t/submit}" type="Emphasized" press=".onFeedback"/></HBox>
									</VBox>
								</f:content>
							</f:Card>
							<f:Card class="tsCard">
								<f:header><card:Header title="Feedback in your scope" statusText="{vm>/perf/fb/count}" iconSrc="sap-icon://discussion"/></f:header>
								<f:content>
									<List items="{vm>/perf/fb/list}" noDataText="No feedback yet.">
										<StandardListItem title="{vm>title}" description="{vm>sub}" info="{vm>date}" icon="{vm>icon}" wrapping="true"/>
									</List>
								</f:content>
							</f:Card>
						</grid:CSSGrid>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</f:content>
	</f:DynamicPage>
</mvc:View>
