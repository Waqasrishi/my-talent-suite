{
	"_version": "1.12.0",
	"sap.app": {
		"id": "zajmn.hr.sucfac1.hk",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.1.0"
		},
		"crossNavigation": {
			"inbounds": {
				"display": {
					"semanticObject": "ZAJMNHR",
					"action": "display",
					"title": "{{appTitle}}",
					"signature": {
						"parameters": {},
						"additionalProperties": "allowed"
					}
				}
			},
			"outbounds": {
				"goals": {
					"semanticObject": "ZAJMNGOALS",
					"action": "display"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": [
			"sap_belize",
			"sap_fiori_3",
			"sap_horizon",
			"sap_bluecrystal"
		]
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "zajmn.hr.sucfac1.hk.view.App",
			"type": "XML",
			"async": true
		},
		"dependencies": {
			"minUI5Version": "1.44.0",
			"libs": {
				"sap.ui.core": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "zajmn.hr.sucfac1.hk.i18n.i18n"
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/people.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.ui.core.routing.Router",
				"async": true
			},
			"routes": [
				{
					"name": "page",
					"pattern": "{all*}:?query:"
				}
			]
		},
		"config": {
			"nav": {
				"goals": {
					"semanticObject": "ZAJMNGOALS",
					"action": "display",
					"url": "../../zajmn.hr.goals.hk/webapp/index.html"
				}
			}
		}
	}
}